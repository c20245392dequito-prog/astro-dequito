---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
const name = "Jive Miguel Dequito";
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{name}</title>
</head>

<body class="portfolio-reveal bg-white text-black dark:bg-gray-950 dark:text-white">

    <!-- HEADER -->
    <header class="flex items-center justify-between bg-slate-200 px-4 py-3 dark:bg-gray-800">

        <h2 class="font-bold text-base">
            {name}
        </h2>

        <!-- NAVIGATION -->
        <nav class="flex gap-5 text-xs">
            <a href="#about">About</a>
            <a href="#work">Work</a>
            <a href="#contact">Contact</a>
        </nav>

        <div class="flex items-center gap-2">
            <button
                id="replayAnimation"
                type="button"
                aria-label="Replay portfolio animations"
                class="rounded-md border border-slate-400 px-3 py-2 text-xs"
            >
                Replay animation
            </button>
            <button
                id="darkModeToggle"
                type="button"
                aria-pressed="false"
                class="theme-toggle rounded-md border border-slate-400 px-3 py-2 text-xs"
            >
                <span id="themeLabel">Dark Mode</span>
            </button>
        </div>

    </header>

    <!-- CONTENT -->
    <main>
        <slot />
    </main>

   

    <Footer />

    <script>
        import "../scripts/animation.js";
    </script>
</body>

</html>