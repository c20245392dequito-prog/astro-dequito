---
const strengths = [
  {
    title: "Creative direction",
    description: "Visual storytelling that feels premium, clear, and memorable from first glance.",
  },
  {
    title: "Product energy",
    description: "Interfaces shaped to feel useful, fluid, and alive without overwhelming the user.",
  },
  {
    title: "Built for motion",
    description: "Thoughtful interactions and layouts designed to communicate personality with intent.",
  },
];
---

<section id="about" class="relative overflow-hidden bg-slate-50 text-slate-900 dark:bg-[#0b1020] dark:text-slate-100">
  <div class="mx-auto max-w-6xl px-6 py-20 lg:px-10">
    <div class="mb-12 flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl" data-reveal>
        <p class="mb-4 text-xs font-medium uppercase tracking-[0.35em] text-cyan-300">About / identity</p>
        <h2 class="text-4xl font-black tracking-tight sm:text-5xl">I build things that feel alive.</h2>
      </div>

      <p class="max-w-xl text-sm leading-7 text-slate-600 dark:text-slate-300 sm:text-base" data-reveal>
        I’m Jive Miguel Dequito — a multidisciplinary creative blending design, storytelling, and digital craft.
        I turn raw ideas into experiences with personality, clarity, and momentum.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
      <div data-reveal="card" class="rounded-[2rem] border border-slate-200 bg-white p-8 shadow-[0_0_40px_rgba(34,211,238,0.12)] backdrop-blur-sm dark:border-white/10 dark:bg-white/5">
        <p class="text-lg leading-8 text-slate-700 dark:text-slate-200">
          My work lives between structure and expression. I like to build brands, interfaces, and content that
          feel intentional rather than generic — systems that look polished, communicate clearly, and leave an emotional
          mark.
        </p>
      </div>

      <div data-reveal="card" class="rounded-[2rem] border border-cyan-400/30 bg-cyan-50 p-8 dark:bg-cyan-500/10">
        <div class="flex flex-wrap gap-2">
          {['Brand systems', 'Creative coding', 'UI direction', 'Storytelling', 'Visual identity'].map((tag) => (
            <span class="rounded-full border border-cyan-300/50 bg-white px-3 py-1 text-xs font-medium text-cyan-800 dark:bg-slate-950/40 dark:text-cyan-200">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {strengths.map((item) => (
        <article data-reveal="card" class="rounded-[1.5rem] border border-slate-200 bg-white p-6 transition-transform duration-300 hover:-translate-y-1 hover:border-cyan-400/40 dark:border-slate-800 dark:bg-slate-900/60">
          <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">{item.title}</p>
          <p class="text-sm leading-7 text-slate-600 dark:text-slate-300">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
